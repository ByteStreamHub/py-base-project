import logging
import pytest
from unittest.mock import MagicMock

from commons.core import ContextFilter, LoggingContext


@pytest.fixture
def log_record() -> logging.LogRecord:
    """Provides a basic LogRecord instance for tests."""
    return logging.LogRecord(
        name="test_logger",
        level=logging.INFO,
        pathname="/fake/path",
        lineno=42,
        msg="This is a test message",
        args=(),
        exc_info=None,
    )


@pytest.fixture
def mock_logger() -> MagicMock:
    """Provides a MagicMock instance of a logger."""
    return MagicMock(spec=logging.Logger)


class TestContextFilter:
    """Groups all tests related to the ContextFilter class."""

    def test_init_nests_context(self):
        """
        Ensures the context dictionary is correctly nested under the 'application' key.
        """
        context = {"request_id": "xyz-123"}
        filter_instance = ContextFilter(context)

        assert filter_instance.context == {"application": context}

    def test_filter_adds_nested_attributes_to_record(self, log_record):
        """
        Tests that the filter correctly adds items from the nested context
        to the log record.
        """
        context = {"user_id": 123, "session_id": "abc"}
        filter_instance = ContextFilter(context)
        
        assert filter_instance.filter(log_record) is True
        
        # Verify that the attributes were added correctly
        assert log_record.user_id == 123
        assert log_record.session_id == "abc"

    def test_filter_with_empty_context(self, log_record):
        """
        Tests that the filter handles an empty context dictionary gracefully.
        """
        initial_attrs = list(log_record.__dict__.keys())
        filter_instance = ContextFilter({})
        
        assert filter_instance.filter(log_record) is True
        
        final_attrs = list(log_record.__dict__.keys())
        assert initial_attrs == final_attrs


class TestLoggingContext:
    """Groups all tests related to the LoggingContext class."""

    def test_init_with_initial_context(self, mock_logger):
        """Tests initialization with a logger and some context."""
        logging_context = LoggingContext(logger=mock_logger, request_id="req-1")

        assert logging_context.logger is mock_logger
        assert logging_context.context == {"request_id": "req-1"}
        assert isinstance(logging_context.filter, ContextFilter)

        assert logging_context.filter.context == {"application": {"request_id": "req-1"}}

    def test_init_without_logger(self):
        """Tests that a default logger is created if none is provided."""

        logging_context = LoggingContext()
        assert isinstance(logging_context.logger, logging.Logger)
        assert logging_context.context == {}

    def test_update_context_modifies_context_and_logs(self, mock_logger):
        """
        Tests that the context is updated AND that a debug message is logged.
        This is the most significant test update.
        """
        logging_context = LoggingContext(logger=mock_logger, user_id=123)
        
        # Action: Update the context
        logging_context.update_context(user_id=456, new_key="value")

        # Assert 1: The context dictionary is updated correctly.
        assert logging_context.context == {"user_id": 456, "new_key": "value"}

        # Assert 2: The logger's debug method was called exactly once.
        mock_logger.debug.assert_called_once()
        
        # Assert 3: Check the arguments passed to the debug method.
        expected_extra = {
            "old_context": {"user_id": 123},
            "new_context": {"user_id": 456, "new_key": "value"},
            "current_context": {"user_id": 456, "new_key": "value"}
        }
        mock_logger.debug.assert_called_once_with(
            "Updated logging context",
            extra=expected_extra
        )

    def test_context_manager_lifecycle(self, mock_logger):
        """
        Tests the full '__enter__' and '__exit__' lifecycle, ensuring
        filters are added and removed correctly.
        """
        with LoggingContext(logger=mock_logger) as ctx:
            # On __enter__, the filter should be added
            mock_logger.addFilter.assert_called_once_with(ctx.filter)
            # The filter should not have been removed yet
            mock_logger.removeFilter.assert_not_called()

        mock_logger.removeFilter.assert_called_once_with(ctx.filter)

    def test_context_manager_cleans_up_on_exception(self, mock_logger):
        """
        Ensures that the filter is removed even if an error occurs inside
        the 'with' block.
        """
        with pytest.raises(ValueError, match="Simulated error"):
            with LoggingContext(logger=mock_logger):
                mock_logger.addFilter.assert_called_once()
                raise ValueError("Simulated error")

        # It verifies cleanup happened after the exception was caught.
        mock_logger.removeFilter.assert_called_once()
